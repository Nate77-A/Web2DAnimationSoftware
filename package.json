{
  "name": "2d-animation-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-first, offline-capable 2D drawing and animation editor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "build:artifact": "vite build --mode artifact",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test src/test/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "vite preview",
    "test:visual": "node scripts/visual.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "jszip": "3.10.1",
    "paper": "^0.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "*",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
